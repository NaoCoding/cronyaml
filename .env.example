# Values referenced with ${NAME} in cron.yaml
REPORT_URL=https://example.com/health

# Gmail example: copy this file to .env and replace these values.
GMAIL_CLIENT_ID=replace-with-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-gmail-oauth-refresh-token
GMAIL_TO=recipient@example.com
GMAIL_SUBJECT=Email sent by CronYAML
GMAIL_BODY=Hello from the CronYAML Gmail example!
